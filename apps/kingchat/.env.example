EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Required for Expo push-token registration. Set this to the EAS project ID after `eas init`.
EXPO_PUBLIC_EAS_PROJECT_ID=

# AdMob: the default app IDs and ad unit in source are Google's TEST IDs.
# Only an adult parent/guardian-owned and approved publisher account may supply
# live values. Do not commit these values to Git.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=

# Public Google OAuth Web client ID used to verify native Android ID tokens in Supabase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional reversed iOS OAuth URL scheme; Android builds do not use this value.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
